/*
 * Copyright (c) 2025 G3rtz
 * SPDX-License-Identifier: MIT
 *
 * ZMK Board Definition for Glorious GMMK Pro (ANSI)
 * MCU: STM32F303CCT6 (ARM Cortex-M4, 72 MHz, 256KB Flash, 40KB RAM)
 * Matrix: 11 rows x 8 columns, col2row diodes
 * Encoder: Alps EC11 on PC14/PC15
 * LED Driver: AW20216S x2 via SPI (currently unsupported in ZMK)
 *
 * Pin mapping verified against QMK keyboard.json:
 *   Columns: PA0-PA4, PA8-PA10 (active high, active drive)
 *   Rows:    PB0-PB10 (active low, active sense)
 *   Encoder: PC15 (A), PC14 (B)
 *   USB:     PA11 (DM), PA12 (DP)
 *   SPI1:    PA5 (SCK), PA6 (MOSI), PA7 (MISO) [for AW20216S]
 *   AW20216S CS: PB13, PB14; Enable: PC13
 */
/dts-v1/;
#include <dt-bindings/zmk/matrix_transform.h>
#include <st/f3/stm32f303Xc.dtsi>
#include <st/f3/stm32f303c(b-c)tx-pinctrl.dtsi>

/* Matrix-Transform (83 Tasten, ANSI) – geteilt mit dem Central */
#include <gmmk_pro_transform.dtsi>

/ {
    model = "GMMK Pro";
    compatible = "glorious,gmmk_pro", "st,stm32f303";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,underglow = &led_matrix_0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
            = <&gpioa 0  GPIO_ACTIVE_HIGH>
            , <&gpioa 1  GPIO_ACTIVE_HIGH>
            , <&gpioa 2  GPIO_ACTIVE_HIGH>
            , <&gpioa 3  GPIO_ACTIVE_HIGH>
            , <&gpioa 4  GPIO_ACTIVE_HIGH>
            , <&gpioa 8  GPIO_ACTIVE_HIGH>
            , <&gpioa 9  GPIO_ACTIVE_HIGH>
            , <&gpioa 10 GPIO_ACTIVE_HIGH>
            ;

        row-gpios
            = <&gpiob 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 1  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpiob 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    encoder0: encoder_0 {
        compatible = "alps,ec11";
        a-gpios = <&gpioc 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpioc 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder0>;
        triggers-per-rotation = <20>;
    };

};

/* SPI1 für AW20216S LED-Treiber: PA5=SCK, PA6=MOSI, PA7=MISO */
&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_sck_pa5 &spi1_mosi_pa6 &spi1_miso_pa7>;
    pinctrl-names = "default";
    cs-gpios = <&gpiob 13 GPIO_ACTIVE_LOW>, <&gpiob 14 GPIO_ACTIVE_LOW>;

    led_matrix_0: aw20216s@0 {
        compatible = "awinic,aw20216s";
        reg = <0>;
        spi-max-frequency = <10000000>;
        enable-gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
    };

    led_matrix_1: aw20216s@1 {
        compatible = "awinic,aw20216s";
        reg = <1>;
        spi-max-frequency = <10000000>;
    };
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /* Set 6KB of storage at the end of the 256KB of flash */
        storage_partition: partition@3e800 {
            reg = <0x0003e800 0x00001800>;
        };
    };
};

zephyr_udc0: &usb {
    pinctrl-0 = <&usb_dm_pa11 &usb_dp_pa12>;
    pinctrl-names = "default";
    status = "okay";
};

/* USART3 auf PC10 (TX) / PC11 (RX) für Split-Verbindung zum nice!nano */
/* PC10/PC11 fehlen in stm32f303c(b-c)tx-pinctrl.dtsi → eigene Definition */
&pinctrl {
    usart3_tx_pc10: usart3_tx_pc10 {
        pinmux = <STM32_PINMUX('C', 10, AF7)>;
        bias-pull-up;
    };
    usart3_rx_pc11: usart3_rx_pc11 {
        pinmux = <STM32_PINMUX('C', 11, AF7)>;
    };
};

&usart3 {
    pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};

/ {
    wired_split: wired_split {
        compatible = "zmk,wired-split";
        device = <&usart3>;
    };
};

&clk_hse {
    status = "okay";
    clock-frequency = <DT_FREQ_M(8)>;
};

&pll {
    prediv = <1>;
    mul = <9>;
    clocks = <&clk_hse>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(72)>;
    ahb-prescaler = <1>;
    apb1-prescaler = <2>;
    apb2-prescaler = <1>;
};
